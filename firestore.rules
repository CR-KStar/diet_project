rules_version = '2';

// 로그인한 사용자는 자기 문서(users/{본인 uid})와 그 하위 데이터만 읽고 쓸 수 있습니다.
// 친구 기능에 필요한 몇몇 컬렉션만 예외적으로 다른 사람도 일부 보고/쓸 수 있게 열어둡니다.
// 그 밖의 모든 경로는 기본적으로 막힙니다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 닉네임처럼 친구 찾기에 필요한 공개용 최소 정보. 로그인만 했으면 누구나 읽을 수
    // 있고(그래야 초대 코드로 상대를 찾을 수 있음), 쓰기는 본인 것만 가능합니다.
    match /publicProfiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 초대 코드 → uid 조회용. 코드로 검색해야 하니 누구나 읽을 수 있고,
    // 쓰기는 그 코드가 가리키는 uid 본인만(자기 코드만 만들 수 있음).
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.uid == request.auth.uid;
    }

    // 친구 요청. 보낸 사람 · 받은 사람만 볼 수 있고, 생성은 보낸 사람만,
    // 상태 변경(수락/거절)은 받은 사람만 할 수 있습니다.
    match /friendRequests/{requestId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.fromUid ||
         request.auth.uid == resource.data.toUid);
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.fromUid;
      allow update, delete: if request.auth != null &&
        request.auth.uid == resource.data.toUid;
    }

    // 확정된 친구 관계. 두 사람 다 읽을 수 있고, 생성은 그 관계에 포함된
    // 사람만 할 수 있습니다(친구 요청을 수락하는 사람이 만듭니다).
    match /friendships/{friendshipId} {
      allow read: if request.auth != null &&
        request.auth.uid in resource.data.users;
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.users;
      allow delete: if request.auth != null &&
        request.auth.uid in resource.data.users;
    }

    // 챌린지. 로그인만 했으면 누구나 보고 새로 만들 수 있고(만든 사람이
    // creatorId), 참여(update로 participantIds에 자기 uid 추가)도 누구나
    // 할 수 있게 열어둡니다. 삭제는 만든 사람만 할 수 있습니다.
    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.creatorId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null &&
        resource.data.creatorId == request.auth.uid;
    }

    // 챌린지 참여자별 오늘 진행 상황(리더보드용). 로그인만 했으면 누구나
    // 읽을 수 있고, 쓰기는 본인 것만 가능합니다.
    match /challengeProgress/{progressId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
    }

    // 친구 활동 피드("누가 뭘 했다"). 정확한 수치가 아니라 짧은 한 줄이라
    // 로그인만 했으면 누구나 읽을 수 있고, 쓰기는 본인 것만 가능합니다.
    match /activityFeed/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
    }
  }
}
